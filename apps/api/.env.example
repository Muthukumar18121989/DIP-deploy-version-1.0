# Comma-separated list of allowed frontend origins, added on top of the
# localhost dev defaults (see app/config.py). Required for any deployment
# where the frontend is on a different host than the backend.
# CORS_ORIGINS=https://your-frontend-url

# Seeded as the one admin account on first startup, only if no admin exists
# yet (see main.py's _seed_default_admin).
#
# Leaving ADMIN_PASSWORD unset is safe anywhere: the account is created with a
# randomly generated password that is printed once to the startup log. Set it
# explicitly when you want to choose the credential yourself — on a hosted
# deployment that is usually easier than reading it back out of the logs.
# ADMIN_EMAIL=admin@decisionos.local
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
